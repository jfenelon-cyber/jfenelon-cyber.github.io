
:root{
  --bg:#03101d;--bg2:#071827;--panel:#0a2135;--panel2:#0d2941;--text:#f4f8fc;
  --muted:#a9bac9;--blue:#1597ff;--cyan:#58c8ff;--line:rgba(68,165,230,.27);
  --gold:#ffbd3f;--shadow:0 22px 60px rgba(0,0,0,.34);--radius:18px;
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--text);background:linear-gradient(180deg,#020b14,#061626 55%,#020b14);line-height:1.68}a{color:inherit}img{max-width:100%;display:block}.shell{width:min(1180px,calc(100% - 40px));margin:auto}.ambient-grid{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.14;background-image:linear-gradient(rgba(60,157,225,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(60,157,225,.1) 1px,transparent 1px);background-size:48px 48px}
.site-header{position:sticky;top:0;z-index:50;background:rgba(2,11,20,.92);border-bottom:1px solid var(--line);backdrop-filter:blur(16px)}.nav-row{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none}.logo-mark{width:44px;height:49px;display:grid;place-items:center;border:2px solid var(--blue);clip-path:polygon(50% 0,94% 18%,86% 76%,50% 100%,14% 76%,6% 18%);font:700 14px "Space Grotesk";color:var(--cyan)}.brand-name{font:700 19px "Space Grotesk";letter-spacing:.6px}.brand-name em{font-style:normal;color:var(--blue)}.nav-links{display:flex;align-items:center;gap:24px}.nav-links a{text-decoration:none;text-transform:uppercase;font-size:12px;font-weight:800;letter-spacing:.8px;padding:28px 0 22px;position:relative}.nav-links a:after{content:"";position:absolute;left:0;right:0;bottom:17px;height:2px;background:var(--blue);transform:scaleX(0);transition:.25s}.nav-links a:hover:after,.nav-links a.active:after{transform:scaleX(1)}.menu-button{display:none;border:0;background:none}.menu-button span{display:block;width:26px;height:2px;background:white;margin:5px}
.page-hero{padding:34px 0 42px;background:radial-gradient(circle at 80% 30%,rgba(21,151,255,.18),transparent 34%),linear-gradient(110deg,#020b16,#071a2d)}.hero-grid{display:grid;grid-template-columns:minmax(330px,43%) 1fr;align-items:center;gap:56px}.portrait-card{position:relative;border:1px solid var(--blue);border-radius:22px;overflow:hidden;box-shadow:var(--shadow)}.portrait-card img{width:100%;height:505px;object-fit:cover;object-position:center}.portrait-status{position:absolute;left:18px;right:18px;bottom:18px;padding:12px 15px;border:1px solid rgba(255,255,255,.15);border-radius:12px;background:rgba(2,12,21,.85);font-size:12px;font-weight:700;backdrop-filter:blur(10px)}.portrait-status span{display:inline-block;width:8px;height:8px;border-radius:50%;background:#44e08d;margin-right:8px;box-shadow:0 0 14px #44e08d}.eyebrow{margin:0 0 10px;color:var(--cyan);font:700 13px "Space Grotesk";letter-spacing:2px}.hero-copy h1,.inner-hero h1,.project-hero h1{font:700 clamp(44px,6vw,76px)/1.03 "Space Grotesk";margin:0 0 8px}.hero-copy h2{font:700 clamp(25px,3vw,38px) "Space Grotesk";color:var(--blue);margin:0 0 14px}.hero-focus{font-weight:700;font-size:16px;line-height:1.9}.lead{font-size:18px;color:#d5e1eb;max-width:820px}.button-row{display:flex;gap:14px;flex-wrap:wrap;margin:24px 0}.button{display:inline-flex;align-items:center;justify-content:center;padding:14px 22px;border-radius:9px;text-decoration:none;text-transform:uppercase;font-size:12px;font-weight:800;letter-spacing:.7px;cursor:pointer}.button.primary{background:var(--blue);border:1px solid var(--blue);box-shadow:0 10px 28px rgba(21,151,255,.24)}.button.secondary{border:1px solid var(--blue);background:rgba(4,17,30,.62)}.button:hover{filter:brightness(1.12);transform:translateY(-2px)}.button.full{width:100%}.trust-row{display:flex;flex-wrap:wrap;gap:8px}.trust-row span,.skill-pills span{padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(10,35,57,.68);font-size:12px;font-weight:700;color:#dfeefa}
.section{padding:82px 0}.section-dark{background:#04111e;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:28px}.section-heading h2,.cta-panel h2{font:700 clamp(30px,4vw,47px)/1.15 "Space Grotesk";margin:0}.text-link{color:var(--cyan);font-weight:800;text-decoration:none}.overview-grid,.project-grid,.credential-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.feature-card,.project-card,.credential-card,.prose-card,.sidebar-card,.contact-panel,.contact-form,.resume-preview,.skill-group{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(12,39,62,.92),rgba(5,19,33,.94));box-shadow:var(--shadow)}.feature-card{padding:25px}.feature-icon{font:700 14px "Space Grotesk";color:var(--cyan);margin-bottom:22px}.feature-card h3,.project-card h3{font:700 20px/1.3 "Space Grotesk";margin:0 0 10px}.feature-card p,.project-card p{color:var(--muted);font-size:14px;margin-bottom:0}.project-grid{grid-template-columns:repeat(3,1fr)}.project-card{padding:25px;min-height:290px;display:flex;flex-direction:column}.project-top{display:flex;justify-content:space-between;align-items:center}.project-tag{display:inline-block;color:var(--cyan);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;margin-bottom:24px}.project-number{color:#55748d;font:700 14px "Space Grotesk"}.project-card a{margin-top:auto;color:var(--cyan);font-weight:800;text-decoration:none}.cta-panel{display:flex;justify-content:space-between;align-items:center;gap:30px;padding:40px;border:1px solid var(--blue);border-radius:var(--radius);background:linear-gradient(120deg,#0b2a45,#061521)}.cta-panel p{color:var(--muted);max-width:760px}
.inner-hero,.project-hero{padding:72px 0;background:radial-gradient(circle at 82% 30%,rgba(21,151,255,.17),transparent 32%),#04111e;border-bottom:1px solid var(--line)}.inner-hero.compact{padding:64px 0}.inner-hero-grid{display:grid;grid-template-columns:1fr 250px;align-items:center;gap:45px}.inner-photo{width:240px;height:240px;object-fit:cover;border-radius:50%;border:2px solid var(--blue);box-shadow:var(--shadow)}.content-grid,.project-detail-grid,.resume-layout{display:grid;grid-template-columns:1fr 330px;gap:28px;align-items:start}.prose-card,.resume-preview{padding:38px}.prose-card h2,.resume-section h3{font-family:"Space Grotesk";margin-top:0;color:#eff8ff}.prose-card p{color:#c7d6e2}.sidebar-card{padding:28px}.sidebar-card h3{font:700 23px "Space Grotesk";margin-top:0}.sticky{position:sticky;top:105px}.check-list{list-style:none;padding:0;margin:0 0 24px}.check-list li{position:relative;padding:10px 0 10px 25px;border-bottom:1px solid rgba(255,255,255,.07)}.check-list li:before{content:"✓";position:absolute;left:0;color:var(--cyan);font-weight:800}.timeline{display:grid;gap:16px}.timeline article{display:grid;grid-template-columns:70px 1fr;gap:20px;padding:24px;border:1px solid var(--line);border-radius:14px;background:#071a2b}.timeline span{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--blue);color:var(--cyan);font-weight:800}.timeline h3{margin:0 0 6px;font-family:"Space Grotesk"}.timeline p{margin:0;color:var(--muted)}
.filter-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px}.filter{padding:10px 16px;border:1px solid var(--line);border-radius:999px;background:#081c2d;color:white;font-weight:700;cursor:pointer}.filter.active,.filter:hover{border-color:var(--blue);color:var(--cyan)}.project-library{grid-template-columns:repeat(3,1fr)}.project-library .project-card.hidden{display:none}
.credential-grid{grid-template-columns:repeat(3,1fr)}.credential-card{padding:30px;text-align:center}.credential-mark{width:82px;height:82px;margin:0 auto 20px;display:grid;place-items:center;border:2px solid var(--blue);clip-path:polygon(50% 0,94% 18%,86% 78%,50% 100%,14% 78%,6% 18%);font:700 25px "Space Grotesk";color:var(--cyan)}.credential-card h2{font-family:"Space Grotesk";margin:0 0 12px}.credential-card p{color:var(--muted)}.credential-card.school .credential-mark{border-color:var(--gold);color:var(--gold)}
.skills-layout{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.skill-group{padding:30px}.skill-group h2{font-family:"Space Grotesk";margin-top:0}.skill-pills{display:flex;flex-wrap:wrap;gap:10px}
.resume-head{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-bottom:24px;border-bottom:1px solid var(--line)}.resume-head h2{font:700 34px "Space Grotesk";margin:0}.resume-head p{margin:5px 0;color:var(--cyan)}.resume-section{padding:25px 0;border-bottom:1px solid rgba(255,255,255,.08)}.resume-section:last-child{border-bottom:0}.resume-section p{color:var(--muted)}
.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px}.contact-panel,.contact-form{padding:34px}.contact-panel h2,.contact-form h2{font-family:"Space Grotesk";margin-top:0}.contact-panel>a,.contact-panel>div{display:flex;flex-direction:column;padding:18px 0;border-bottom:1px solid rgba(255,255,255,.08);text-decoration:none}.contact-panel span{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--cyan)}.contact-form label{display:block;font-weight:700;margin:0 0 16px}.contact-form input,.contact-form textarea{width:100%;margin-top:7px;padding:13px;border:1px solid var(--line);border-radius:8px;background:#041321;color:white;font:inherit}.contact-form input:focus,.contact-form textarea:focus{outline:1px solid var(--blue)}.form-note{font-size:12px;color:var(--muted)}
.project-hero .back-link{display:inline-block;margin-bottom:28px;color:var(--cyan);text-decoration:none;font-weight:800}.project-detail-grid .skill-pills{margin-top:22px}.next-project{display:block;margin-top:24px;color:var(--cyan);font-weight:800;text-decoration:none}
.site-footer{border-top:1px solid var(--line);background:#020a12;padding:25px 0}.footer-row{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:30px}.footer-row p{margin:3px 0;color:var(--muted);font-size:12px}.footer-links{display:flex;gap:18px}.footer-links a{text-decoration:none;color:#dcebf6;font-size:13px}.copyright{text-align:right}.back-top{position:fixed;right:22px;bottom:22px;width:45px;height:45px;border-radius:50%;border:1px solid var(--blue);background:#082037;color:white;font-size:20px;opacity:0;pointer-events:none;transition:.25s}.back-top.show{opacity:1;pointer-events:auto}.reveal{opacity:0;transform:translateY(20px);transition:.65s}.reveal.visible{opacity:1;transform:none}
@media(max-width:980px){.nav-links{gap:15px}.overview-grid{grid-template-columns:repeat(2,1fr)}.project-grid,.project-library,.credential-grid{grid-template-columns:repeat(2,1fr)}.hero-grid{gap:32px}.portrait-card img{height:430px}}
@media(max-width:820px){.menu-button{display:block}.nav-links{display:none;position:absolute;left:0;right:0;top:76px;flex-direction:column;align-items:flex-start;padding:18px 24px;background:#03101d;border-bottom:1px solid var(--line)}.nav-links.open{display:flex}.nav-links a{padding:10px 0;width:100%}.nav-links a:after{bottom:3px}.hero-grid,.inner-hero-grid,.content-grid,.project-detail-grid,.resume-layout,.contact-grid{grid-template-columns:1fr}.hero-copy{text-align:center}.hero-copy .lead{margin-left:auto;margin-right:auto}.button-row,.trust-row{justify-content:center}.portrait-card{max-width:520px;margin:auto}.inner-photo{margin:auto}.sidebar-card.sticky{position:static}.skills-layout{grid-template-columns:1fr}.footer-row{grid-template-columns:1fr;text-align:center}.footer-links{justify-content:center}.copyright{text-align:center}}
@media(max-width:600px){.shell{width:min(100% - 24px,1180px)}.hero-copy h1,.inner-hero h1,.project-hero h1{font-size:42px}.portrait-card img{height:auto}.overview-grid,.project-grid,.project-library,.credential-grid{grid-template-columns:1fr}.section-heading,.cta-panel,.resume-head{align-items:flex-start;flex-direction:column}.section{padding:62px 0}.prose-card,.resume-preview,.sidebar-card,.contact-panel,.contact-form{padding:24px}}

.document-feature{display:flex;justify-content:space-between;align-items:center;gap:30px;padding:34px;border:1px solid var(--blue);border-radius:var(--radius);background:linear-gradient(120deg,#0b2a45,#061521);margin-bottom:56px}
.document-feature h2{font:700 clamp(28px,4vw,42px)/1.15 "Space Grotesk";margin:0 0 12px}
.document-feature p{color:var(--muted);max-width:760px}
.document-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}
.documentation-heading{margin-top:20px}
.document-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.document-card{padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(12,39,62,.92),rgba(5,19,33,.94));box-shadow:var(--shadow);display:flex;flex-direction:column;min-height:310px}
.document-card h2{font:700 20px/1.35 "Space Grotesk";margin:0 0 12px}
.document-card p{color:var(--muted);font-size:14px}
.document-card .document-actions{margin-top:auto}
@media(max-width:980px){.document-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.document-feature{align-items:flex-start;flex-direction:column}.document-grid{grid-template-columns:1fr}}

/* =========================================================
   PREMIUM RECRUITER-FOCUSED REDESIGN — JULY 2026
   ========================================================= */
:root{
  --bg:#020817;
  --bg2:#061226;
  --panel:rgba(8,24,48,.78);
  --panel2:rgba(11,34,66,.86);
  --text:#f4f8ff;
  --muted:#9fb2cb;
  --blue:#2d8cff;
  --cyan:#60e6ff;
  --violet:#856cff;
  --green:#57e6a7;
  --line:rgba(128,190,255,.18);
  --glow:0 0 0 1px rgba(84,170,255,.10),0 22px 70px rgba(0,0,0,.42);
  --radius:24px;
}
html{background:#020817}
body{
  min-height:100vh;
  background:
    radial-gradient(circle at 10% 10%,rgba(45,140,255,.16),transparent 30%),
    radial-gradient(circle at 88% 18%,rgba(96,230,255,.10),transparent 28%),
    linear-gradient(180deg,#020817 0%,#061226 48%,#020817 100%);
  color:var(--text);
  overflow-x:hidden;
}
body:before{
  content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;
  background:
    linear-gradient(rgba(89,165,255,.045) 1px,transparent 1px),
    linear-gradient(90deg,rgba(89,165,255,.045) 1px,transparent 1px);
  background-size:58px 58px;
  mask-image:linear-gradient(to bottom,black,transparent 88%);
}
.shell{width:min(1220px,calc(100% - 48px))}
.site-header{
  background:rgba(2,8,23,.78);
  border-bottom:1px solid rgba(118,190,255,.14);
  box-shadow:0 10px 40px rgba(0,0,0,.20);
}
.nav-row{height:84px}
.brand{gap:14px}
.logo-mark{
  width:50px;height:54px;border:1px solid rgba(96,230,255,.75);
  background:linear-gradient(145deg,rgba(45,140,255,.18),rgba(96,230,255,.05));
  box-shadow:0 0 28px rgba(45,140,255,.22);
}
.brand-name{font-size:20px;letter-spacing:.8px}
.brand-name em{color:var(--cyan)}
.nav-links{gap:28px}
.nav-links a{font-size:11px;letter-spacing:1.15px;color:#c9d8ea;transition:.25s}
.nav-links a:hover,.nav-links a.active{color:white}
.nav-links a:after{
  height:2px;border-radius:8px;
  background:linear-gradient(90deg,var(--blue),var(--cyan));
  box-shadow:0 0 12px rgba(96,230,255,.55)
}
.page-hero{
  min-height:720px;
  display:flex;align-items:center;
  padding:82px 0 96px;
  position:relative;overflow:hidden;
  background:
    radial-gradient(circle at 82% 35%,rgba(45,140,255,.18),transparent 35%),
    radial-gradient(circle at 10% 90%,rgba(133,108,255,.13),transparent 30%);
}
.page-hero:after{
  content:"";position:absolute;width:600px;height:600px;right:-240px;top:30px;
  border:1px solid rgba(96,230,255,.12);border-radius:50%;
  box-shadow:0 0 0 70px rgba(45,140,255,.025),0 0 0 140px rgba(45,140,255,.018);
}
.hero-grid{grid-template-columns:410px 1fr;gap:74px;position:relative;z-index:1}
.portrait-card{
  border:1px solid rgba(96,230,255,.45);
  border-radius:34px;
  background:linear-gradient(145deg,rgba(45,140,255,.20),rgba(4,13,28,.7));
  padding:10px;
  box-shadow:0 28px 90px rgba(0,0,0,.52),0 0 50px rgba(45,140,255,.14)
}
.portrait-card:before{
  content:"SECURITY OPERATIONS";position:absolute;z-index:2;top:22px;left:22px;
  padding:8px 11px;border-radius:999px;background:rgba(2,8,23,.72);
  border:1px solid rgba(96,230,255,.25);font-size:10px;font-weight:800;letter-spacing:1.3px;color:var(--cyan)
}
.portrait-card img{height:520px;border-radius:25px;filter:saturate(.95) contrast(1.04)}
.portrait-status{
  left:25px;right:25px;bottom:25px;border-radius:14px;
  background:rgba(2,8,23,.84);border:1px solid rgba(87,230,167,.24)
}
.eyebrow{font-size:12px;letter-spacing:2.7px;color:var(--cyan)}
.hero-copy h1{
  font-size:clamp(58px,7vw,92px);letter-spacing:-3.8px;
  background:linear-gradient(115deg,#fff 20%,#cfe7ff 55%,#68e6ff);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  text-shadow:0 0 50px rgba(45,140,255,.10)
}
.hero-copy h2{font-size:clamp(27px,3vw,42px);color:#9dc8ff;letter-spacing:-1px}
.hero-focus{color:#dce9f7;font-size:15px;letter-spacing:.2px}
.lead{color:#b6c6da;line-height:1.75}
.button{
  min-height:48px;border-radius:12px;padding:14px 23px;
  transition:transform .22s,box-shadow .22s,background .22s;
}
.button.primary{
  background:linear-gradient(135deg,var(--blue),#1474ee 60%,var(--violet));
  border:0;box-shadow:0 15px 38px rgba(45,140,255,.28)
}
.button.secondary{
  border:1px solid rgba(96,230,255,.34);
  background:rgba(8,25,50,.56);backdrop-filter:blur(12px)
}
.button:hover{transform:translateY(-3px);box-shadow:0 18px 42px rgba(45,140,255,.25)}
.trust-row{margin-top:28px}
.trust-row span,.skill-pills span{
  border:1px solid rgba(105,182,255,.20);
  background:rgba(9,30,58,.62);padding:9px 13px;color:#d7e8f8;
  box-shadow:inset 0 1px rgba(255,255,255,.03)
}
.hero-stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:34px
}
.hero-stat{
  padding:17px 16px;border:1px solid rgba(109,184,255,.16);border-radius:16px;
  background:linear-gradient(145deg,rgba(10,33,64,.72),rgba(3,13,28,.66));
  box-shadow:inset 0 1px rgba(255,255,255,.03)
}
.hero-stat strong{display:block;font:700 25px "Space Grotesk";color:#fff}
.hero-stat span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.85px}
.section{padding:105px 0}
.section-dark{background:rgba(2,9,20,.48)}
.section-heading{margin-bottom:38px}
.section-heading h2,.cta-panel h2{letter-spacing:-1.6px}
.feature-card,.project-card,.credential-card,.prose-card,.sidebar-card,.contact-panel,.contact-form,.resume-preview,.skill-group,.document-card{
  border:1px solid rgba(122,190,255,.17);
  background:linear-gradient(145deg,rgba(10,31,60,.80),rgba(4,15,32,.84));
  box-shadow:var(--glow);
  backdrop-filter:blur(14px);
}
.feature-card,.project-card,.document-card,.credential-card{
  position:relative;overflow:hidden;transition:transform .25s,border-color .25s,box-shadow .25s
}
.feature-card:before,.project-card:before,.document-card:before,.credential-card:before{
  content:"";position:absolute;inset:0 0 auto 0;height:2px;
  background:linear-gradient(90deg,transparent,var(--blue),var(--cyan),transparent);opacity:.55
}
.feature-card:hover,.project-card:hover,.document-card:hover,.credential-card:hover{
  transform:translateY(-7px);border-color:rgba(96,230,255,.36);
  box-shadow:0 28px 80px rgba(0,0,0,.48),0 0 28px rgba(45,140,255,.10)
}
.feature-card{padding:30px;min-height:250px}
.feature-icon{
  width:48px;height:48px;display:grid;place-items:center;border-radius:14px;
  background:linear-gradient(145deg,rgba(45,140,255,.24),rgba(96,230,255,.08));
  border:1px solid rgba(96,230,255,.22);margin-bottom:28px
}
.project-card{padding:30px;min-height:325px}
.project-tag{padding:7px 10px;border-radius:999px;background:rgba(45,140,255,.10);border:1px solid rgba(96,230,255,.18)}
.project-card h3{font-size:23px;letter-spacing:-.5px}
.project-card a{display:inline-flex;align-items:center;gap:7px}
.cta-panel{
  padding:52px;border-radius:28px;
  background:
    radial-gradient(circle at 80% 20%,rgba(96,230,255,.13),transparent 28%),
    linear-gradient(120deg,rgba(12,48,90,.92),rgba(5,18,38,.94));
  box-shadow:0 28px 90px rgba(0,0,0,.45)
}
.inner-hero,.project-hero{
  padding:105px 0 82px;position:relative;overflow:hidden;
  background:
    radial-gradient(circle at 85% 25%,rgba(45,140,255,.20),transparent 34%),
    linear-gradient(120deg,#020817,#07172e);
}
.inner-hero:after,.project-hero:after{
  content:"";position:absolute;right:-120px;bottom:-260px;width:560px;height:560px;
  border-radius:50%;border:1px solid rgba(96,230,255,.13);
  box-shadow:0 0 0 70px rgba(45,140,255,.025),0 0 0 140px rgba(45,140,255,.015)
}
.inner-hero .shell,.project-hero .shell{position:relative;z-index:1}
.inner-hero h1,.project-hero h1{
  max-width:1000px;font-size:clamp(48px,6vw,78px);letter-spacing:-3px;
  background:linear-gradient(110deg,#fff,#cbe6ff 58%,#71e7ff);
  -webkit-background-clip:text;background-clip:text;color:transparent
}
.project-hero .back-link{
  padding:9px 13px;border-radius:10px;border:1px solid rgba(96,230,255,.20);
  background:rgba(7,25,50,.56);margin-bottom:34px
}
.project-hero .skill-pills{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.project-detail-grid{grid-template-columns:minmax(0,1fr) 360px;gap:34px}
.prose-card{padding:46px}
.prose-card h2{font-size:29px;margin-top:42px;padding-bottom:13px;border-bottom:1px solid rgba(113,185,255,.14)}
.prose-card h2:first-child{margin-top:0}
.sidebar-card{padding:30px}
.sidebar-card .button{margin-top:11px}
.check-list li{padding:13px 0 13px 29px;color:#d6e3f1}
.check-list li:before{color:var(--green)}
.document-card{min-height:330px}
.contact-panel>a:hover{color:var(--cyan)}
.site-footer{background:#020817}
.back-top{background:linear-gradient(135deg,var(--blue),var(--violet));border:0}
@media(max-width:980px){
  .hero-grid{grid-template-columns:340px 1fr;gap:42px}
  .portrait-card img{height:440px}
  .hero-stats{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:820px){
  .page-hero{min-height:auto;padding:70px 0}
  .hero-grid{grid-template-columns:1fr}
  .portrait-card{max-width:420px}
  .hero-copy h1{font-size:58px;letter-spacing:-2.5px}
}
@media(max-width:600px){
  .shell{width:min(100% - 28px,1220px)}
  .hero-copy h1,.inner-hero h1,.project-hero h1{font-size:44px;letter-spacing:-1.8px}
  .hero-stats{grid-template-columns:1fr 1fr}
  .section{padding:76px 0}
  .project-hero{padding:72px 0 62px}
  .prose-card{padding:26px}
}
